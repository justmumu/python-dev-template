{
  "env": {
    "CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING": "1",
    "ENABLE_LSP_TOOL": "1"
  },
  "permissions": {
    "allow": [
      "Bash(make help)",
      "Bash(make version)",
      "Bash(make check)",
      "Bash(make test)",
      "Bash(make lint)",
      "Bash(make lint-fix)",
      "Bash(make format)",
      "Bash(make format-check)",
      "Bash(make typecheck)",
      "Bash(make lock-check)",
      "Bash(make docs-build)",
      "Bash(make pre-commit)",
      "Bash(uv run:*)",
      "Bash(uv sync:*)",
      "Bash(uv lock)",
      "Bash(uv lock --check)",
      "Bash(uv tree:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch)"
    ]
  },
  "effortLevel": "high",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-pyproject.py"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "superpowers@superpowers-marketplace": true,
    "pyright-lsp@claude-plugins-official": true,
    "caveman@caveman": true
  },
  "extraKnownMarketplaces": {
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      },
      "autoUpdate": true
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      },
      "autoUpdate": true
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      },
      "autoUpdate": true
    }
  },
  "attribution": {
    "commit": "",
    "pr": ""
  }
}
